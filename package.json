{
  "name": "whosyourbirdy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-only bird song identification on top of BirdNET v2.4 (non-commercial)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-ort-wasm.mjs",
    "model:build": "python3 scripts/fetch_artifacts.py && .venv/bin/python scripts/convert_to_onnx.py",
    "parity": "node scripts/parity.mjs",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc -b --noEmit false --pretty"
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
